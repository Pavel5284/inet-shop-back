# Скопируйте в .env (cp .env.example .env) и поправьте значения.
# Эти переменные нужны, когда бэкенд запускается ВНЕ Docker (npm run start:dev).
# Внутри docker compose они задаются в docker-compose.yml.

NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=shop
DB_PASSWORD=shop_pass
DB_NAME=shop

# Секрет подписи JWT. В production — длинная случайная строка (>= 32 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-dev-secret-change-me-dev-secret
JWT_EXPIRES_IN_SECONDS=604800

# Адреса фронтенда, которым разрешены запросы (CORS), через запятую. Пусто — CORS выключен.
CORS_ORIGINS=http://localhost:5173

# Заполнить пустую БД тестовыми данными при старте (демо-аккаунт demo@example.com / Demo12345!)
SEED_ON_START=true

# Применять схему из сущностей без миграций (только для экспериментов!). В production — false.
DB_SYNCHRONIZE=false

# Сколько reverse-proxy перед приложением (0 — нет, 1 — nginx, 2 — Caddy + nginx)
TRUST_PROXY_HOPS=0
