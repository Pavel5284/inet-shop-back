# Скопируйте в .env (Windows PowerShell: Copy-Item .env.example .env) и поправьте значения.
# Файл читается и docker compose, и приложением при запуске на хосте (npm run start:dev).

# ---------- Общее ----------
NODE_ENV=development
PORT=3000

# ---------- База данных ----------
POSTGRES_VERSION=18
# DB_HOST/DB_PORT нужны приложению на хосте; внутри compose они задаются сервису как db:5432.
DB_HOST=localhost
DB_PORT=5432
# Порт БД на вашем компьютере (только локальный compose). Поменяйте, если 5432 занят.
DB_PORT_HOST=5432
DB_USER=shop
DB_PASSWORD=shop_pass
DB_NAME=shop

# ---------- Бэкенд ----------
# Для сервера — длинная случайная строка. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-dev-secret-change-me-dev-secret
JWT_EXPIRES_IN_SECONDS=604800

# Адреса фронтенда, которым разрешены запросы (CORS), через запятую. Пусто — CORS выключен.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# true — один раз заполнить пустую БД тестовыми товарами и демо-аккаунтом
# (demo@example.com / Demo12345!). Для локального запуска на хосте выставьте true;
# в локальном compose значение принудительно true, в production-compose — false.
SEED_ON_START=false

# Применять схему из сущностей без миграций (только для экспериментов!). В production — false.
DB_SYNCHRONIZE=false

# Сколько reverse-proxy перед приложением (0 — нет, 1 — nginx, 2 — Caddy + nginx).
TRUST_PROXY_HOPS=0

# ---------- Только для боевого сервера (docker-compose.prod.yml) ----------
# Ваш домен. Для проверки prod-режима у себя на компьютере можно поставить localhost.
DOMAIN=shop.example.com
# Метка версии образов
APP_VERSION=1.0.0
# Показывать ли кнопку «Войти как демо-пользователь»
VITE_SHOW_DEMO_LOGIN=false
VITE_CURRENCY=RUB
